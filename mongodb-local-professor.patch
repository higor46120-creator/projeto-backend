+# Copie este arquivo para ".env" (na raiz do projeto) e preencha.
+# O .env está no .gitignore: NUNCA suba senhas para o GitHub.
+
+# ---------- Qual banco usar ----------
+# local     -> MongoDB na sua máquina (docker compose up -d)
+# professor -> MongoDB Atlas do professor (preencha MONGODB_URI abaixo)
+spring.profiles.active=local
+
+# ---------- Perfil professor ----------
+# MONGODB_URI=mongodb+srv://USUARIO:SENHA@CLUSTER.mongodb.net/?retryWrites=true&w=majority
+# MONGODB_DATABASE=helptec
+
+# ---------- Perfil local (opcionais) ----------
+# MONGODB_URI_LOCAL=mongodb://localhost:27017
+# MONGODB_DATABASE_LOCAL=helptec_local
+# SEED_SENHA=helptec123
+# Seu e-mail do Google, para entrar no app com "Entrar com Google" como ADMIN:
+# SEED_GOOGLE_ADMIN_EMAIL=seu.email@gmail.com
+
+# ---------- Comuns ----------
+# Chave do JWT em Base64 (openssl rand -base64 64). Vazia = gera uma aleatória a cada execução.
+# JWT_SECRET=
+# GOOGLE_CLIENT_ID=
+# GOOGLE_CLIENT_SECRET=
+# FIREBASE_CREDENTIALS_JSON=
+# FIREBASE_STORAGE_BUCKET=
