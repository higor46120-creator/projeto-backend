From 1e4d0a77d1233c88b82a027591dac31c786aed60 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Wed, 11 Nov 2026 19:15:34 -0300
Subject: [PATCH] Reativa o login com Google pelo navegador (oauth2Login)
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

O commit "Correção pro Mobile" removeu o .oauth2Login() do SecurityConfig,
e o front web passou a receber 404 em /oauth2/authorization/google.
O login web volta a funcionar; a API continua respondendo 401 em JSON
por causa do authenticationEntryPoint explícito, então o mobile não é afetado.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_012xpyFRPS2vqxyuCv6P8vvC
---
 .../fiec/helptec/config/SecurityConfig.java   | 29 ++++++++++++++++++-
 1 file changed, 28 insertions(+), 1 deletion(-)

diff --git a/src/main/java/br/edu/fiec/helptec/config/SecurityConfig.java b/src/main/java/br/edu/fiec/helptec/config/SecurityConfig.java
index 036418e..989b190 100644
--- a/src/main/java/br/edu/fiec/helptec/config/SecurityConfig.java
+++ b/src/main/java/br/edu/fiec/helptec/config/SecurityConfig.java
@@ -1,5 +1,6 @@
 package br.edu.fiec.helptec.config;
 
+import org.springframework.beans.factory.annotation.Value;
 import org.springframework.context.annotation.Bean;
 import org.springframework.context.annotation.Configuration;
 import org.springframework.http.HttpStatus;
@@ -16,6 +17,8 @@ import org.springframework.web.cors.CorsConfiguration;
 import org.springframework.web.cors.CorsConfigurationSource;
 import org.springframework.web.cors.UrlBasedCorsConfigurationSource;
 
+import java.net.URLEncoder;
+import java.nio.charset.StandardCharsets;
 import java.util.List;
 
 @Configuration
@@ -25,10 +28,18 @@ public class SecurityConfig {
 
     private final JwtAuthenticationFilter jwtAuthFilter;
     private final AuthenticationProvider authenticationProvider;
+    private final OAuth2SuccessHandler oAuth2SuccessHandler;
 
-    public SecurityConfig(JwtAuthenticationFilter jwtAuthFilter, AuthenticationProvider authenticationProvider) {
+    // Mesma URL usada pelo OAuth2SuccessHandler (front: /oauth2/redirect)
+    @Value("${app.oauth2.redirect-uri:http://localhost:3000/oauth2/redirect}")
+    private String frontendRedirectUri;
+
+    public SecurityConfig(JwtAuthenticationFilter jwtAuthFilter,
+                          AuthenticationProvider authenticationProvider,
+                          OAuth2SuccessHandler oAuth2SuccessHandler) {
         this.jwtAuthFilter = jwtAuthFilter;
         this.authenticationProvider = authenticationProvider;
+        this.oAuth2SuccessHandler = oAuth2SuccessHandler;
     }
 
     private static final String[] PUBLIC_MATCHERS = {
@@ -80,6 +91,22 @@ public class SecurityConfig {
 
                 .authenticationProvider(authenticationProvider)
 
+                // Login com Google pelo NAVEGADOR (front web): /oauth2/authorization/google
+                // -> Google -> /login/oauth2/code/google -> OAuth2SuccessHandler gera o JWT
+                // e redireciona para app.oauth2.redirect-uri?token=...
+                // O mobile continua usando POST /api/v1/auth/google com o ID token.
+                // Como o authenticationEntryPoint acima é explícito, a API continua respondendo
+                // 401 em JSON (e não redireciona para a página do Google).
+                .oauth2Login(oauth2 -> oauth2
+                        .successHandler(oAuth2SuccessHandler)
+                        // Em caso de falha, devolve para o front com ?error=... (em vez de /login?error,
+                        // que não existe no backend e virava uma página 404)
+                        .failureHandler((request, response, exception) -> response.sendRedirect(
+                                frontendRedirectUri + "?error=" + URLEncoder.encode(
+                                        String.valueOf(exception.getMessage()), StandardCharsets.UTF_8)
+                        ))
+                )
+
                 // Insere o filtro JWT antes do filtro padrão do Spring
                 .addFilterBefore(jwtAuthFilter, UsernamePasswordAuthenticationFilter.class);
 
