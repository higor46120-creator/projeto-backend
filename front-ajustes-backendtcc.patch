             Predicate nomeLike = cb.like(cb.lower(root.get("nome")), pattern);
             Predicate patrimonioLike = cb.like(cb.lower(root.get("patrimonio")), pattern);
             Predicate statusLike = cb.like(cb.lower(root.get("status")), pattern);
-            predicates.add(cb.or(nomeLike, patrimonioLike, statusLike));
+            Predicate tipoLike = cb.like(cb.lower(root.get("tipo")), pattern);
+            Predicate areaLike = cb.like(cb.lower(root.get("area")), pattern);
+            Predicate descricaoLike = cb.like(cb.lower(root.get("descricao")), pattern);
+            predicates.add(cb.or(nomeLike, patrimonioLike, statusLike, tipoLike, areaLike, descricaoLike));
         }
 
         // Filtros específicos
@@ -102,6 +105,14 @@ public class EquipamentoRepositoryCustomImpl implements EquipamentoRepositoryCus
             predicates.add(cb.like(cb.lower(root.get("tipo")), "%" + filtro.getTipo().toLowerCase() + "%"));
         }
 
+        if (filtro.getArea() != null && !filtro.getArea().trim().isEmpty()) {
+            predicates.add(cb.like(cb.lower(root.get("area")), "%" + filtro.getArea().toLowerCase() + "%"));
+        }
+
+        if (filtro.getIdSala() != null) {
+            predicates.add(cb.equal(root.get("idSala"), filtro.getIdSala()));
+        }
+
         if (filtro.getPrecoMin() != null) {
             predicates.add(cb.greaterThanOrEqualTo(root.get("preco"), filtro.getPrecoMin()));
         }
