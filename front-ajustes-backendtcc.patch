diff --git a/deployment.yaml b/deployment.yaml
index 7a9d08d..8b8d153 100644
--- a/deployment.yaml
+++ b/deployment.yaml
@@ -7,6 +7,8 @@ data:
   DB_HOST: "host.minikube.internal"
   DB_PORT: "3310"
   DB_NAME: "helptec"
+  # Endereço do site (front) que pode chamar a API. TROQUE pelo domínio de vocês.
+  CORS_ALLOWED_ORIGINS: "https://helptec.SEU-DOMINIO"
   DB_USER: "root"
   # Troque pelo bucket do seu projeto (Firebase Console > Storage)
   FIREBASE_STORAGE_BUCKET: "SEU-PROJETO.firebasestorage.app"
@@ -143,3 +145,40 @@ spec:
       port: 80
       targetPort: 80
       nodePort: 30081
+
+---
+# Entrada pelo domínio com https (o Google só aceita https ou localhost).
+# No minikube, ative antes:  minikube addons enable ingress
+# Certificado:  kubectl create secret tls helptech-tls --cert=certificado.crt --key=chave.key
+apiVersion: networking.k8s.io/v1
+kind: Ingress
+metadata:
+  name: helptech-ingress
+spec:
+  ingressClassName: nginx
+  tls:
+    - hosts:
+        - helptec.SEU-DOMINIO       # TROQUE
+        - api.helptec.SEU-DOMINIO   # TROQUE
+      secretName: helptech-tls
+  rules:
+    - host: helptec.SEU-DOMINIO     # TROQUE
+      http:
+        paths:
+          - path: /
+            pathType: Prefix
+            backend:
+              service:
+                name: helptech-frontend-service
+                port:
+                  number: 80
+    - host: api.helptec.SEU-DOMINIO # TROQUE
+      http:
+        paths:
+          - path: /
+            pathType: Prefix
+            backend:
+              service:
+                name: helptech-backend-service
+                port:
+                  number: 8080
